# Clés API - copiez ce fichier en .env et renseignez vos clés

# Football : https://www.football-data.org/client/register (gratuit, 10 req/min)
FOOTBALL_DATA_API_KEY=your_football_data_api_key_here

# Balldontlie : pas de clé nécessaire pour le plan gratuit (30 req/min)
BALLDONTLIE_API_KEY=

# The Odds API : https://the-odds-api.com/ (gratuit, 500 req/mois)
# → Permet d'afficher les cotes bookmakers et de calculer la valeur espérée (EV)
ODDS_API_KEY=
